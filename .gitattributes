# Normalize line endings to LF in the repository for all text files.
* text=auto eol=lf

# Explicitly treat these as text with LF endings.
*.py     text eol=lf
*.toml   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
Makefile text eol=lf
LICENSE  text eol=lf

# Mark the typing marker as text.
py.typed text eol=lf
